  "properties": {
    "active_programs": {
      "default": 0,
      "title": "Active Programs",
      "type": "integer"
    },
    "blocked_programs": {
      "default": 0,
      "title": "Blocked Programs",
      "type": "integer"
    },
    "completed_programs": {
      "default": 0,
      "title": "Completed Programs",
      "type": "integer"
