          "title": "Leading Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "program_id": {
          "title": "Program Id",
          "type": "string"
        },
        "ready_plan_count": {
          "default": 0,
          "title": "Ready Plan Count",
          "type": "integer"
        },
        "running_campaigns": {
          "default": 0,
          "title": "Running Campaigns",
          "type": "integer"
